    assert lock_versions("pnpm-lock.yaml", "packages:\n  /left-pad@1.3.0:\n    resolution: {}\n", {"left-pad"}) == {"left-pad": "1.3.0"}
    assert declared_cargo('[package]\nname="x"\n[dependencies]\nserde = "1.0"\n[dev-dependencies.tokio]\nversion = "1"\n') == {"serde", "tokio"}
    cg = dependency_changes(diff_by_file('+++ b/Cargo.toml\n@@ -1 +1 @@\n-serde = "1.0.100"\n+serde = { version = "1.0.150", features = ["derive"] }\n'),
                            lambda p: '[dependencies]\nserde = "1"\n', lambda p: "")
    assert [(c["name"], c["old"], c["new"]) for c in cg] == [("serde", "1.0.100", "1.0.150")], cg
    assert trim_changelog("# Changelog\n\n## 1.2.0\nnew\n## 1.1.0\nmid\n## 1.0.0\nold\n", vkey("1.0.0"), vkey("1.1.0")) == "## 1.1.0\nmid\n"
    fetch_cmd = stub
    try:
        with tempfile.TemporaryDirectory() as out:
            with open(os.path.join(out, "diff.patch"), "w") as fh:
                fh.write(gomod + pkgjson)
            os.makedirs(os.path.join(out, "web"))
            with open(os.path.join(out, "web", "package.json"), "w") as fh:
                fh.write(heads["web/package.json"])
            items, diags = upstream_stage(out, "", "", {"diff": os.path.join(out, "diff.patch")}, gomod + pkgjson)
            msgs = {it[4].split(" ")[1].rstrip(":"): it[4] for it in items}
            tpath = os.path.join(out, "upstream", "github.com_stretchr_testify")
            assert msgs["github.com/stretchr/testify"] == (
                f"upstream github.com/stretchr/testify v1.8.0→v1.9.0 (latest v1.10.0): {tpath}/releases.md"), msgs
            notes = open(os.path.join(tpath, "releases.md")).read()
            assert "notes for v1.10.0" in notes and "notes for v1.9.0" in notes and "notes for v1.8.4" in notes, notes
            assert "notes for v1.8.0" not in notes and "notes for v1.7.0" not in notes, notes
            assert "v1.11.0-rc1" in open(os.path.join(tpath, "versions.txt")).read()
            lp = os.path.join(out, "upstream", "left-pad", "releases.md")
            assert msgs["left-pad"] == f"upstream left-pad added at 1.3.0 (latest 1.3.0): {lp}", msgs
            assert "left-pad 1.3.0 body" in open(lp).read()
            assert msgs["golang.org/x/sys"].startswith("upstream golang.org/x/sys: unavailable (") , msgs
            assert diags == [{"tool": "upstream", "file": "go.mod", "line": 5,
                              "message": "github.com/stretchr/testify is pinned at v1.9.0; the latest release is v1.10.0"}], diags
            # out set: files land there, not beside the diff
            od = os.path.join(out, "node-out")
            os.makedirs(od)
            items, _ = upstream_stage(out, "", "", {"out": od, "diff": os.path.join(out, "diff.patch")}, pkgjson)
            lp2 = os.path.join(od, "upstream", "left-pad", "releases.md")
            assert items[0][4] == f"upstream left-pad added at 1.3.0 (latest 1.3.0): {lp2}" and os.path.isfile(lp2), items
            # PR fields: contract wins; null falls through
            assert pr_body(out, {"pr_body": "fixes #7"}) == "fixes #7" and pr_body(out, {"pr_body": ""}) == ""
            assert pr_body(out, {"pr_body": None}) == ""
            # no output directory from the harness: a scratch directory, said so in the pointer
            items, _ = upstream_stage(out, "", "", {}, pkgjson)
            assert "scratch dir" in items[0][4] and "review-upstream-" in items[0][4], items
    finally:
        fetch_cmd = real
    assert upstream_stage(".", "", "", {}, "+++ b/a.go\n+x := 1\n") == ([], [])



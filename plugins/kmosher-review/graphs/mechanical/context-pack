#!/usr/bin/env python3
"""A review-run mechanical node: point the generators at the files outside the
diff that the changed files depend on or are depended on by, so a lens can
check a claim against the file it is about instead of trusting it.

stdin is the mechanical contract (JSON; see docs/review-harness.md in
metawork), stdout is {"diagnostics": [], "context": [...], "triggers": []}. Each
context line is one pointer, never file contents:

    <changed file> -> <kind>: <path>[:<line>] -- <why>

kinds are referrer (a file elsewhere that mentions a changed, renamed or
deleted path), include (a Makefile include, a relative TS/JS import, a
Dockerfile build input), package (a Go sibling in the same package) and
sibling (a function in the same file with a similar name to a changed one).
Three further sources emit free-form lines instead: `cites #N: "<title>" (<state>)`
for issues and PRs named in the added lines, the commit messages or the PR body,
`dependency <import> → <dir>` for modules newly imported, and `precedent for
<call>: <path:line>, ...` for qualified calls newly written. `upstream <pkg> <old>→<new> (latest <v>): <path>` for the dependency
bumps and additions in the diff (go.mod, package.json and its lockfiles, Cargo.toml, and imports above):
release notes between the versions, fetched with go, gh and curl into <out>/upstream/<pkg>/ (`out` is the
contract's per-node directory, kept with the bundle; absent from an older harness, the directory holding the
saved diff; a scratch directory if neither is writable), 12 s in all and 3 s a call, with
`upstream <pkg>: unavailable (<why>)` on any failure and a diagnostic when the pin is not the latest.
The contract also carries `pr_number` (int or null) and `pr_body` (string or null); null means unknown, not
empty, and the citations stage then falls back to REVIEW_PR_NUMBER / `gh pr view` and REVIEW_PR_BODY / pr-body.md.
`--self-test` runs the regexes over fixtures and the upstream stage over a stubbed network. The whole output is capped at MAX_ITEMS. Any error yields fewer items, or none;
this node never fails the run.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import time

MAX_ITEMS = int(os.environ.get("CONTEXT_PACK_MAX_ITEMS", "118"))
MAX_FILES = 30
MAX_REFERRERS = 8
MAX_IMPORTS = 6
DEADLINE = time.monotonic() + 8.0

GENERIC_BASENAMES = {
    "index.ts", "index.js", "index.tsx", "main.go", "main.py", "main.rs", "mod.rs", "lib.rs",
    "readme.md", "makefile", "dockerfile", "build.bazel", "package.json", "config.ts", "config.go",
    "config.py", "utils.ts", "utils.go", "types.ts", "types.go", "test.ts", "setup.py", "__init__.py",
    "tsconfig.json", "go.mod", "cargo.toml", "pulumi.yaml", ".gitignore", ".dockerignore",
}
SKIP_DIRS = ("node_modules", "vendor", "third_party", "dist", "build", "bazel-*", "generated", "__generated__")
SKIP_FILES = ("*.pb.go", "*.pb.ts", "*_generated.*", "*.gen.*", "*.lock", "package-lock.json", "go.sum",
              "*.min.js", "*.snap", "CHANGELOG*", "*.svg", "*.png")
KEYWORDS = {"if", "for", "while", "switch", "catch", "function", "return", "constructor", "else", "do", "try"}

DEF_PATTERNS = {
    ".go": [r"^func\s+(?:\([^)]*\)\s*)?(\w+)"],
    ".ts": [r"^\s*(?:export\s+)?(?:default\s+)?(?:async\s+)?function\*?\s+(\w+)",
            r"^\s*(?:export\s+)?(?:const|let|var)\s+(\w+)\s*(?::[^=]+)?=\s*(?:async\s*)?(?:\([^)]*\)|\w+)\s*(?::[^=]+)?=>",
            r"^\s+(?:(?:public|private|protected|static|async|readonly)\s+)*(\w+)\s*\([^)]*\)\s*(?::\s*[^{;]+)?\{\s*$"],
    ".py": [r"^\s*(?:async\s+)?def\s+(\w+)"],
    ".rs": [r"^\s*(?:pub(?:\([^)]*\))?\s+)?(?:async\s+)?(?:unsafe\s+)?fn\s+(\w+)"],
    ".sh": [r"^(?:function\s+)?(\w+)\s*\(\)\s*\{"],
}
for _ext in (".tsx", ".js", ".jsx", ".mjs", ".cjs"):
    DEF_PATTERNS[_ext] = DEF_PATTERNS[".ts"]
DEF_PATTERNS[".bash"] = DEF_PATTERNS[".sh"]
DEF_PATTERNS[".zsh"] = DEF_PATTERNS[".sh"]


def remaining():
    return max(0.5, DEADLINE - time.monotonic())


def git(ws, *args):
    """Stdout of a git command, or "" on any failure or when the deadline is spent."""
    if time.monotonic() > DEADLINE:
        return ""
    try:
        r = subprocess.run(["git", "-C", ws, *args], capture_output=True, timeout=remaining(),
                           text=True, errors="replace")
    except Exception:
        return ""
    return r.stdout if r.returncode == 0 else ""


class Repo:
    def __init__(self, ws, base, head):
        self.ws, self.base, self.head = ws, base, head
        self.rev = head or ""
        listing = git(ws, "ls-tree", "-r", "--name-only", self.rev) if self.rev else git(ws, "ls-files")
        self.tree = set(listing.splitlines())
        self._cache = {}
        self.edited = set()

    def read(self, path):
        if path not in self._cache:
            if self.rev:
                text = git(self.ws, "show", f"{self.rev}:{path}")
            else:
                try:
                    with open(os.path.join(self.ws, path), errors="replace") as fh:
                        text = fh.read()
                except Exception:
                    text = ""
            self._cache[path] = text
        return self._cache[path]


def skipped(path):
    from fnmatch import fnmatch
    parts = path.split("/")
    if any(fnmatch(p, d) for p in parts[:-1] for d in SKIP_DIRS):
        return True
    return any(fnmatch(parts[-1], f) for f in SKIP_FILES)


def changed_set(ws, base, head, contract):
    """[(status, old, new)] with status in A M D R; renames need base and head."""
    out = []
    if base and head:
        raw = git(ws, "diff", "-M", "--name-status", "-z", base, head)
        toks = raw.split("\0")
        i = 0
        while i < len(toks) and toks[i]:
            st = toks[i][0]
            if st in "RC":
                old, new = toks[i + 1], toks[i + 2]
                out.append(("R" if st == "R" else "A", old, new))
                i += 3
            else:
                out.append((st, toks[i + 1], toks[i + 1]))
                i += 2
    if not out:
        out = [("M", f, f) for f in contract.get("changed_files") or []]
    return out


def added_lines(ws, base, head, contract):
    """{new path: [added line numbers]} from the diff the harness saved, else git."""
    text = ""
    p = contract.get("diff")
    if p:
        try:
            with open(p, errors="replace") as fh:
                text = fh.read()
        except Exception:
            text = ""
    if not text and base and head:
        text = git(ws, "diff", "-U0", "-M", base, head)
    result, path, n = {}, None, 0
    for line in text.splitlines():
        if line.startswith("+++ "):
            path = line[4:].strip()
            path = path[2:] if path.startswith("b/") else (None if path == "/dev/null" else path)
        elif line.startswith("@@"):
            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)", line)
            n = int(m.group(1)) if m else 0
        elif path and n:
            if line.startswith("+"):
                result.setdefault(path, []).append(n)
                n += 1
            elif line.startswith(" "):
                n += 1
    return result


def tokens(name):
    name = name.replace("_", " ")
    name = re.sub(r"([a-z0-9])([A-Z])", r"\1 \2", name)
    name = re.sub(r"([A-Z]+)([A-Z][a-z])", r"\1 \2", name)
    return [t.lower() for t in name.split()]


def definitions(repo, path):
    pats = DEF_PATTERNS.get(os.path.splitext(path)[1].lower())
    if not pats:
        return []
    pats = [re.compile(p) for p in pats]
    defs = []
    for i, line in enumerate(repo.read(path).splitlines(), 1):
        if len(line) > 300:
            continue
        for p in pats:
            m = p.match(line)
            if m and m.group(1) not in KEYWORDS:
                defs.append((i, m.group(1)))
                break
    return defs


def sibling_items(repo, new, lines):
    defs = definitions(repo, new)
    if not defs or not lines:
        return []
    changed = {}
    for ln in lines:
        enclosing = [d for d in defs if d[0] <= ln]
        if enclosing:
            changed[enclosing[-1][1]] = enclosing[-1][0]
    items = []
    for name in list(changed)[:4]:
        tk = tokens(name)
        if len(tk) < 2:
            continue
        sibs = []
        for line, other in defs:
            if other == name or other in changed:
                continue
            ot = tokens(other)
            shared = 0
            while shared < min(len(tk), len(ot)) and tk[shared] == ot[shared]:
                shared += 1
            if shared >= 2 or (shared == 1 and len(tk) <= 2):
                sibs.append((-shared, line, other))
        for _, line, other in sorted(sibs)[:3]:
            items.append((1, new, "sibling", f"{new}:{line}", f"`{other}` is named like the changed `{name}`; compare guards and error handling"))
    return items


def resolve(repo, base_dir, target):
    cand = os.path.normpath(os.path.join(base_dir, target))
    return cand if cand in repo.tree else None


def include_items(repo, new):
    base = os.path.basename(new)
    d = os.path.dirname(new)
    ext = os.path.splitext(new)[1].lower()
    text = None
    items = []
    if base in ("Makefile", "makefile", "GNUmakefile") or ext in (".mk", ".mak"):
        text = repo.read(new)
        for i, line in enumerate(text.splitlines(), 1):
            m = re.match(r"^-?(?:s?include)\s+(.+)$", line)
            if not m:
                continue
            for t in m.group(1).split("#")[0].split():
                if "$" in t:
                    items.append((2, new, "include", f"{new}:{i}", f"includes `{t}`, a computed path; resolve it"))
                    continue
                hit = resolve(repo, d, t) or (t if t in repo.tree else None)
                if hit:
                    items.append((2, new, "include", hit, f"`include {t}` at {new}:{i}; check variables and flags it sets (.SHELLFLAGS, .ONESHELL, SHELL)"))
    elif ext in (".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"):
        text = repo.read(new)
        seen = set()
        imports = []
        for m in re.finditer(r"""(?:from\s+|require\(\s*|import\(\s*|import\s+)['"](\.{1,2}/[^'"]+)['"]""", text):
            t = m.group(1)
            for suffix in ("", ".ts", ".tsx", ".js", ".jsx", ".mjs", "/index.ts", "/index.tsx", "/index.js"):
                hit = resolve(repo, d, t + suffix)
                if hit and hit not in seen and hit != new:
                    seen.add(hit)
                    ln = text.count("\n", 0, m.start()) + 1
                    imports.append((hit, f"imported at {new}:{ln}"))
                    break
        # An import that is itself edited in this diff is the likeliest cross-file contradiction.
        imports.sort(key=lambda im: im[0] not in repo.edited)
        for hit, why in imports[:MAX_IMPORTS]:
            edited = hit in repo.edited
            items.append((1 if edited else 5, new, "include", hit, why + ("; also edited in this diff" if edited else "")))
        if len(imports) > MAX_IMPORTS:
            items.append((5, new, "include", "...", f"{len(imports) - MAX_IMPORTS} more relative imports"))
    elif base == "Dockerfile" or base.startswith("Dockerfile.") or ext == ".dockerfile":
        text = repo.read(new)
        stages = {}
        for i, line in enumerate(text.splitlines(), 1):
            m = re.match(r"^\s*FROM\s+\S+(?:\s+--\S+)*\s+AS\s+(\S+)", line, re.I)
            if m:
                stages[m.group(1).lower()] = i
        for i, line in enumerate(text.splitlines(), 1):
            m = re.match(r"^\s*COPY\s+--from=(\S+)", line, re.I)
            if m:
                name = m.group(1)
                if name.lower() in stages:
                    items.append((2, new, "include", f"{new}:{stages[name.lower()]}", f"stage `{name}` copied from at line {i}"))
                else:
                    items.append((2, new, "include", f"{new}:{i}", f"`--from={name}` is a named build context or external image; find where it is supplied"))
            elif re.match(r"^\s*(?:COPY|ADD)\s", line, re.I):
                args = [a for a in line.split()[1:] if not a.startswith("--")]
                for src in args[:-1]:
                    for cand in (os.path.normpath(os.path.join(d, src)), os.path.normpath(src)):
                        if cand in repo.tree:
                            items.append((2, new, "include", cand, f"copied at {new}:{i}"))
                            break
        for extra in ("BUILD.bazel", "BUILD", ".dockerignore"):
            p = os.path.normpath(os.path.join(d, extra))
            if p in repo.tree:
                items.append((2, new, "include", p, "build definition beside the Dockerfile; check it still matches"))
    elif ext == ".go":
        stem = base[:-3].removesuffix("_test")
        sibs = sorted((p for p in repo.tree if os.path.dirname(p) == d and p.endswith(".go") and p != new),
                      key=lambda p: (not os.path.basename(p).startswith(stem), p))
        for p in sibs[:3]:
            items.append((4, new, "package", p, "same Go package"))
        if len(sibs) > 3:
            items.append((4, new, "package", d + "/", f"{len(sibs) - 3} more files in the package"))
    return [(pri, f, kind, ptr, why) for pri, f, kind, ptr, why in items]


def referrer_items(repo, changes):
    """One git grep for every changed path and distinctive basename."""
    pats = {}  # pattern -> list of (changed file, status, new path)
    for st, old, new in changes:
        keys = [old] if st in "DR" else [new]
        if st == "R":
            keys.append(new)  # a new path can already be named by files elsewhere
        for k in keys:
            pats.setdefault(k, []).append((new, st, old, new))
        if st in "DR":
            b = os.path.basename(old)
            if b.lower() not in GENERIC_BASENAMES and len(b) >= 6:
                pats.setdefault(b, []).append((new, st, old, new))
    if not pats:
        return []
    args = ["grep", "-n", "-I", "-F"]
    for p in pats:
        args += ["-e", p]
    if repo.rev:
        args.append(repo.rev)
    args.append("--")
    args += [":(exclude,glob)**/%s/**" % d for d in SKIP_DIRS]
    args += [":(exclude,glob)**/%s" % f for f in SKIP_FILES]
    out = git(repo.ws, "grep", *args[1:])
    hits = {}  # (pattern, referrer path) -> first line number
    prefix = repo.rev + ":" if repo.rev else ""
    for row in out.splitlines():
        if prefix and row.startswith(prefix):
            row = row[len(prefix):]
        parts = row.split(":", 2)
        if len(parts) < 3 or not parts[1].isdigit():
            continue
        path, ln, text = parts[0], int(parts[1]), parts[2]
        for p in pats:
            if p in text:
                hits.setdefault((p, path), ln)
    items = []
    for p, owners in pats.items():
        for changed, st, old, new in owners:
            found = [(path, ln) for (q, path), ln in hits.items() if q == p and path not in (old, new)]
            found.sort()
            if not found:
                continue
            for path, ln in found[:MAX_REFERRERS]:
                if st == "D":
                    why = f"deleted path still referenced ({'`' + p + '`'})"
                    pri = 0
                elif st == "R" and p != new:
                    why = f"renamed from `{old}`; still references `{p}`"
                    pri = 0
                else:
                    why = f"mentions `{p}`"
                    pri = 3
                if path in {n for _, _, n in changes}:
                    why += "; also edited in this diff"
                items.append((pri, new, "referrer", f"{path}:{ln}", why))
            if len(found) > MAX_REFERRERS:
                items.append((3, new, "referrer", "...", f"{len(found) - MAX_REFERRERS} more files mention `{p}`"))
    return items


# --- references followed out of the diff: citations, precedent, dependency source ---

CITE_BUDGET = 4.0      # seconds of the deadline the citation lookups may spend
MAX_CITES = 8
MAX_PRECEDENT_IDENTS = 10
MAX_SITES = 3
MAX_GO_MODULES = 5
MAX_TS_PACKAGES = 5
GH_TIMEOUT = 3.0
GO_LIST_TIMEOUT = 2.0
START = time.monotonic()

CITE_PATTERNS = [
    re.compile(r"https?://github\.com/([\w.-]+/[\w.-]+)/(?:issues|pull)/(\d{1,6})\b"),
    re.compile(r"\b(?:PR|pull request|issue)s?\s+#?(\d{1,6})\b", re.I),
    re.compile(r"(?<![\w&/#.-])#(\d{1,5})\b"),
]
GO_QUALIFIED = re.compile(r"(?<![\w.])([A-Za-z_]\w*\.[A-Z]\w*)\(")
TS_QUALIFIED = re.compile(r"(?<![\w.$])([a-z]\w*\.[a-z]\w*)\(")
GO_IMPORT = re.compile(r'^\s*(?:import\s+)?(?:[\w._]+\s+)?"([^"\s]+)"\s*(?://.*)?$')
TS_IMPORT = re.compile(r"""(?:\bfrom\s+|\brequire\(\s*|\bimport\(\s*|^\s*import\s+)['"]([^'".][^'"]*)['"]""")
# Receivers and methods that are the standard library or a test harness: a precedent for them teaches nothing.
NOISE_RECEIVERS = {
    "fmt", "errors", "strings", "strconv", "os", "io", "ioutil", "bytes", "sort", "time", "sync", "context",
    "log", "filepath", "path", "json", "reflect", "regexp", "bufio", "atomic", "slog", "t", "b", "require",
    "assert", "console", "this", "self", "super", "process", "window", "document", "Math", "expect", "JSON",
    "Object", "Array", "Promise", "err", "ctx", "wg", "mu", "cmd",
}
NOISE_METHODS = {
    "Error", "String", "Close", "Done", "Lock", "Unlock", "RLock", "RUnlock", "Add", "Wait", "Helper", "Run",
    "Fatal", "Fatalf", "Errorf", "Log", "Logf", "Skip", "Skipf", "Parallel", "Cleanup", "Unwrap", "Is", "As",
    "Len", "Get", "Set", "Sprintf", "Printf", "Println", "Equal", "NoError", "Nil", "True", "False",
    "log", "map", "filter", "forEach", "push", "join", "split", "then", "catch", "map", "includes", "slice",
    "toString", "keys", "values", "entries", "trim", "replace", "test", "has", "get", "set", "add", "delete",
}
NODE_BUILTINS = {
    "fs", "path", "os", "util", "http", "https", "url", "stream", "events", "crypto", "child_process", "assert",
    "buffer", "zlib", "net", "tls", "dns", "readline", "process", "module", "worker_threads", "timers", "vm",
}


def diff_text(ws, base, head, contract):
    p = contract.get("diff")
    if p:
        try:
            with open(p, errors="replace") as fh:
                text = fh.read()
            if text:
                return text
        except Exception:
            pass
    return git(ws, "diff", "-U0", "-M", base, head) if base and head else ""


def added_content(text):
    """[(new path, line text)] for every added line of a unified diff."""
    out, path = [], None
    for line in text.splitlines():
        if line.startswith("+++ "):
            path = line[4:].strip()
            path = path[2:] if path.startswith("b/") else (None if path == "/dev/null" else path)
        elif line.startswith("+") and path:
            out.append((path, line[1:]))
    return out


def find_citations(text):
    """Ordered distinct (repo or None, number) cited in text."""
    found = []
    for m in CITE_PATTERNS[0].finditer(text):
        found.append((m.group(1), int(m.group(2))))
    for pat in CITE_PATTERNS[1:]:
        for m in pat.finditer(text):
            found.append((None, int(m.group(1))))
    seen, out = set(), []
    for ref in found:
        if ref[1] > 0 and ref not in seen:
            seen.add(ref)
            out.append(ref)
    return out


def pr_body(ws, contract):
    """The PR body: the contract's pr_body when it is a string (null means unknown), else
    REVIEW_PR_BODY (a file path, else the text itself), or a pr-body.md in the workspace or beside the saved diff."""
    if isinstance(contract.get("pr_body"), str):
        return contract["pr_body"]
    env = os.environ.get("REVIEW_PR_BODY", "")
    cands = [env] if env else []
    cands.append(os.path.join(ws, "pr-body.md"))
    if contract.get("diff"):
        cands.append(os.path.join(os.path.dirname(contract["diff"]), "pr-body.md"))
    for c in cands:
        if os.path.isfile(c):
            try:
                with open(c, errors="replace") as fh:
                    return fh.read()
            except Exception:
                continue
    return env if env and not os.path.exists(env) else ""


class Gh:
    """gh with a per-call timeout; dies quietly when gh is missing, unauthenticated or too slow."""

    def __init__(self, ws):
        self.ws = ws
        self.dead = shutil.which("gh") is None

    def run(self, *args):
        if self.dead or time.monotonic() > DEADLINE:
            return None
        try:
            r = subprocess.run(["gh", *args], cwd=self.ws, capture_output=True, text=True, errors="replace",
                               timeout=min(GH_TIMEOUT, remaining()))
        except Exception:
            self.dead = True
            return None
        if r.returncode != 0:
            err = r.stderr.lower()
            if "auth" in err or "login" in err or "gh_token" in err:
                self.dead = True
            return None
        return r.stdout

    def lookup(self, repo, n):
        extra = ["--repo", repo] if repo else []
        for kind in ("issue", "pr"):
            out = self.run(kind, "view", str(n), "--json", "number,title,state,url", *extra)
            if out:
                try:
                    return json.loads(out)
                except ValueError:
                    continue
        return None


def citation_items(ws, base, head, contract, text):
    refs = []
    for path, line in added_content(text):
        if not skipped(path):
            refs += find_citations(line)
    if base and head:
        refs += find_citations(git(ws, "log", "--format=%B", f"{base}..{head}"))
    refs += find_citations(pr_body(ws, contract))
    seen, distinct = set(), []
    for ref in refs:
        if ref not in seen:
            seen.add(ref)
            distinct.append(ref)
    if not distinct:
        return []
    gh = Gh(ws)
    own = ""
    pn = contract.get("pr_number")
    if isinstance(pn, int) and not isinstance(pn, bool) and pn > 0:
        own = str(pn)
    if not own:
        own = os.environ.get("REVIEW_PR_NUMBER", "").strip().lstrip("#")
    if not own.isdigit():
        out = gh.run("pr", "view", "--json", "number")
        try:
            own = str(json.loads(out)["number"]) if out else ""
        except Exception:
            own = ""
    items = []
    for repo, n in distinct:
        if len(items) >= MAX_CITES or time.monotonic() - START > CITE_BUDGET:
            break
        if repo is None and str(n) == own:
            continue
        info = gh.lookup(repo, n)
        if gh.dead and not info:
            break
        if not info:
            continue
        name = f"{repo}#{n}" if repo else f"#{n}"
        title = " ".join(str(info.get("title", "")).split())[:90]
        items.append((-2, None, None, f"cite:{name}",
                      f'cites {name}: "{title}" ({str(info.get("state", "?")).lower()}) — '
                      f"check the citation says what the comment claims"))
    return items


def qualified_calls(text):
    """Counter of qualified call identifiers in added lines, by language of the file."""
    from collections import Counter
    counts = Counter()
    for path, line in added_content(text):
        ext = os.path.splitext(path)[1].lower()
        if skipped(path) or line.lstrip().startswith(("//", "#", "*", "/*")):
            continue
        if ext == ".go":
            pat = GO_QUALIFIED
        elif ext in (".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"):
            pat = TS_QUALIFIED
        else:
            continue
        for ident in pat.findall(line):
            recv, meth = ident.split(".")
            if recv in NOISE_RECEIVERS or meth in NOISE_METHODS:
                continue
            counts[(ident, ext == ".go")] += 1
    return counts


def precedent_items(repo, changes, text):
    counts = qualified_calls(text)
    if not counts:
        return []
    excludes = [f":(exclude,literal){new}" for _, _, new in changes]
    excludes += [":(exclude,glob)**/%s/**" % d for d in SKIP_DIRS]
    excludes += [":(exclude,glob)**/%s" % f for f in SKIP_FILES]
    items = []
    for (ident, is_go), _ in counts.most_common(MAX_PRECEDENT_IDENTS):
        globs = ["*.go"] if is_go else ["*.ts", "*.tsx", "*.js", "*.jsx", "*.mjs"]
        args = ["grep", "-n", "-I", "-F", "-e", ident + "("]
        if repo.rev:
            args.append(repo.rev)
        out = git(repo.ws, *args, "--", *globs, *excludes)
        prefix = repo.rev + ":" if repo.rev else ""
        sites, files = [], set()
        for row in out.splitlines():
            if prefix and row.startswith(prefix):
                row = row[len(prefix):]
            parts = row.split(":", 2)
            if len(parts) < 3 or not parts[1].isdigit() or parts[0] in files:
                continue
            files.add(parts[0])
            sites.append(f"{parts[0]}:{parts[1]}")
        sites.sort(key=lambda s: bool(re.search(r"_test\.go|\.test\.|\.spec\.|/tests?/", s.split(":")[0])))
        if sites:
            items.append((0, None, None, f"precedent:{ident}",
                          f"precedent for {ident}: {', '.join(sites[:MAX_SITES])} — compare argument order and "
                          f"shape before calling the diff's use a preference"))
    return items


def go_module_for(repo, start_dir, imp):
    """(module path, go.mod dir, version, own module?) for the longest go.mod requirement prefixing imp."""
    d = start_dir
    while True:
        gm = os.path.join(d, "go.mod") if d else "go.mod"
        if gm in repo.tree:
            break
        if not d:
            return None
        d = os.path.dirname(d)
    text = repo.read(gm)
    own = re.search(r"^module\s+(\S+)", text, re.M)
    if own and (imp == own.group(1).strip('"') or imp.startswith(own.group(1).strip('"') + "/")):
        return None
    best = None
    for m in re.finditer(r"^\s*(?:require\s+)?([\w.~/-]+\.[\w.~/-]+)\s+(v[\w.+-]+)", text, re.M):
        mod, ver = m.group(1), m.group(2)
        if (imp == mod or imp.startswith(mod + "/")) and (best is None or len(mod) > len(best[0])):
            best = (mod, d, ver)
    return best


def module_dir(ws, gomod_dir, mod, ver):
    cwd = os.path.join(ws, gomod_dir) if gomod_dir else ws
    env = dict(os.environ, GOFLAGS="-mod=mod", GOPROXY="off")
    try:
        r = subprocess.run(["go", "list", "-m", "-f", "{{.Dir}}", mod], cwd=cwd, env=env, capture_output=True,
                           text=True, timeout=min(GO_LIST_TIMEOUT, remaining()))
        out = r.stdout.strip()
        if r.returncode == 0 and out and os.path.isdir(out):
            return out
    except Exception:
        pass
    root = os.environ.get("GOMODCACHE") or os.path.join(os.path.expanduser("~"), "go", "pkg", "mod")
    esc = re.sub(r"[A-Z]", lambda m: "!" + m.group(0).lower(), mod)
    cand = os.path.join(root, f"{esc}@{ver}")
    return cand if os.path.isdir(cand) else None


def ts_declared(repo, start_dir, pkg):
    """The version a package.json at or above start_dir declares for pkg, else None."""
    d = start_dir
    while True:
        pj = os.path.join(d, "package.json")
        if pj in repo.tree:
            v = spec_version(declared_npm(repo.read(pj)).get(pkg, ""))
            if v:
                return v
        if not d:
            return None
        d = os.path.dirname(d)


def dependency_items(repo, changes, text):
    items, go_seen, ts_seen = [], set(), set()
    for path, line in added_content(text):
        if skipped(path):
            continue
        ext = os.path.splitext(path)[1].lower()
        if ext == ".go" and len(go_seen) < MAX_GO_MODULES:
            m = GO_IMPORT.match(line)
            if not m or "." not in m.group(1).split("/")[0] or m.group(1) in go_seen:
                continue
            imp = m.group(1)
            hit = go_module_for(repo, os.path.dirname(path), imp)
            if not hit:
                continue
            go_seen.add(imp)
            mod, gomod_dir, ver = hit
            IMPORTED.append(("go", mod, ver, gomod_dir))
            mdir = module_dir(repo.ws, gomod_dir, mod, ver)
            if not mdir:
                continue
            sub = imp[len(mod):].lstrip("/")
            pdir = os.path.join(mdir, sub) if sub and os.path.isdir(os.path.join(mdir, sub)) else mdir
            items.append((-1, None, None, f"dep:{imp}",
                          f"dependency {imp} → {pdir} — read it before judging a call's semantics"))
        elif ext in (".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs") and len(ts_seen) < MAX_TS_PACKAGES:
            m = TS_IMPORT.search(line)
            if not m or m.group(1).startswith("node:"):
                continue
            parts = m.group(1).split("/")
            pkg = "/".join(parts[:2]) if parts[0].startswith("@") else parts[0]
            if pkg in NODE_BUILTINS or pkg in ts_seen:
                continue
            d = os.path.dirname(path)
            declared = ts_declared(repo, d, pkg)
            if declared:
                IMPORTED.append(("npm", pkg, declared, ""))
            while True:
                cand = os.path.join(repo.ws, d, "node_modules", pkg)
                if os.path.isdir(cand):
                    ts_seen.add(pkg)
                    rel = os.path.normpath(os.path.join(d, "node_modules", pkg))
                    items.append((-1, None, None, f"dep:{pkg}",
                                  f"dependency {pkg} → {rel} — read it before judging a call's semantics"))
                    break
                if not d:
                    break
                d = os.path.dirname(d)
    return items


# --- upstream: what the registries know about the dependencies the diff touches ---

UPSTREAM_BUDGET = 12.0   # seconds for the whole stage
FETCH_TIMEOUT = 3.0      # seconds for one network call
MAX_UPSTREAM = 6
MAX_NOTES_BYTES = 40 * 1024
UA = "kmosher-review-upstream (https://github.com/kmosher/claude-plugins)"
# Dependencies the dependency stage found in imports; it appends (ecosystem, name, version, go.mod dir).
IMPORTED = []
UPSTREAM_END = None


class FetchError(Exception):
    pass


def fetch_cmd(argv, cwd=None, env=None, timeout=None):
    """Stdout of a gh, curl or go call. Raises FetchError with a short reason; self-test replaces this."""
    t = min(timeout or FETCH_TIMEOUT, FETCH_TIMEOUT)
    if UPSTREAM_END is not None:
        if UPSTREAM_END - time.monotonic() <= 0.1:
            raise FetchError("stage budget spent")
        t = min(t, UPSTREAM_END - time.monotonic())
    try:
        r = subprocess.run(argv, cwd=cwd, env=env, capture_output=True, text=True, errors="replace", timeout=t)
    except subprocess.TimeoutExpired:
        raise FetchError(f"{argv[0]} timed out after {t:g}s")
    except OSError as e:
        raise FetchError(f"{argv[0]}: {e.strerror or e}")
    if r.returncode != 0:
        last = (r.stderr.strip().splitlines() or [f"exit {r.returncode}"])[-1]
        raise FetchError(f"{argv[0]}: {last[:80]}")
    return r.stdout


def curl(url):
    return fetch_cmd(["curl", "-sSfL", "--max-time", f"{FETCH_TIMEOUT:g}", "-A", UA, url])


def show_rev(ws, rev, path):
    """A file at a revision, "" when absent; independent of the stage deadlines above."""
    if not rev:
        return ""
    try:
        r = subprocess.run(["git", "-C", ws, "show", f"{rev}:{path}"], capture_output=True, text=True,
                           errors="replace", timeout=2.0)
    except Exception:
        return ""
    return r.stdout if r.returncode == 0 else ""


SEMVER = re.compile(r"v?(\d+)(?:\.(\d+))?(?:\.(\d+))?(?:[-+]([0-9A-Za-z.+-]+))?")


def vkey(s):
    """Sort key for a version or tag; a release sorts above its own prereleases. None if not a version."""
    m = SEMVER.search(s or "")
    if not m:
        return None
    a, b, c, pre = m.groups()
    return (int(a), int(b or 0), int(c or 0), 0 if pre else 1, pre or "")


def is_pseudo(v):
    return bool(re.search(r"-\d{14}-[0-9a-f]{12}$", v or ""))


def diff_by_file(text):
    """{path: [(sign, new line number or None, text)]} for the +/- lines of a unified diff."""
    out, path, n = {}, None, 0
    for line in text.splitlines():
        if line.startswith("+++ "):
            path = line[4:].strip()
            path = path[2:] if path.startswith("b/") else (None if path == "/dev/null" else path)
        elif line.startswith("--- "):
            continue
        elif line.startswith("@@"):
            m = re.match(r"@@ -\d+(?:,\d+)? \+(\d+)", line)
            n = int(m.group(1)) if m else 0
        elif path and line.startswith("+"):
            out.setdefault(path, []).append(("+", n, line[1:]))
            n += 1
        elif path and line.startswith("-"):
            out.setdefault(path, []).append(("-", None, line[1:]))
        elif path and line.startswith(" "):
            n += 1
    return out


GOMOD_REQ = re.compile(r"^\s*(?:require\s+)?([\w.~/-]+\.[\w.~/-]+)\s+(v[\w.+-]+)(\s*//\s*indirect)?")
JSON_DEP = re.compile(r'^\s*"([^"]+)"\s*:\s*"([^"]*)"')
CARGO_DEP = re.compile(r'^\s*([A-Za-z0-9_-]+)\s*=\s*(?:"([^"]+)"|\{[^}]*\bversion\s*=\s*"([^"]+)")')


def spec_version(spec):
    """The first concrete version in an npm or Cargo range, or None for tags, URLs and workspace refs."""
    m = re.search(r"\d+(?:\.\d+){0,2}(?:-[0-9A-Za-z.-]+)?", spec or "")
    return m.group(0) if m and not re.match(r"^(?:git|http|file|link|workspace|npm:)", spec) else None


def lock_versions(path, text, names):
    """{name: version} for names in a lockfile; package-lock.json, yarn.lock (v1) and pnpm-lock.yaml."""
    out = {}
    base = os.path.basename(path)
    if base == "package-lock.json":
        try:
            pk = json.loads(text).get("packages") or {}
        except ValueError:
            return out
        for n in names:
            v = (pk.get(f"node_modules/{n}") or {}).get("version")
            if v:
                out[n] = v
    elif base == "yarn.lock":
        for m in re.finditer(r'^"?((?:@[^@\s"]+/)?[^@\s"]+)@[^\n]*:\n\s+version "?([^"\n]+)"?', text, re.M):
            if m.group(1) in names:
                out.setdefault(m.group(1), m.group(2))
    elif base == "pnpm-lock.yaml":
        for m in re.finditer(r"^\s+/?'?((?:@[^@\s']+/)?[^@\s']+)@(\d[^\s:'()]*)[^\n]*:\s*$", text, re.M):
            if m.group(1) in names:
                out.setdefault(m.group(1), m.group(2))
    return out


def declared_npm(text):
    try:
        j = json.loads(text)
    except ValueError:
        return {}
    d = {}
    for k in ("dependencies", "devDependencies", "optionalDependencies"):
        d.update(j.get(k) or {})
    return d


def declared_cargo(text):
    names = set()
    sect = ""
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("["):
            sect = s
            m = re.match(r"\[(?:[\w.-]+\.)?(?:dev-|build-)?dependencies\.([A-Za-z0-9_-]+)\]", s)
            if m:
                names.add(m.group(1))
        elif re.search(r"dependencies\]$", sect):
            m = CARGO_DEP.match(line)
            if m:
                names.add(m.group(1))
    return names


def dependency_changes(by_file, show_head, show_base):
    """Dependency changes in a diff: dicts of eco, name, old, new, rank (0 bump, 1 add, 3 indirect), file, line."""
    found = []
    for path, rows in by_file.items():
        base = os.path.basename(path)
        d = os.path.dirname(path)
        if base == "go.mod":
            old = {}
            for sign, _, t in rows:
                m = GOMOD_REQ.match(t) if sign == "-" else None
                if m:
                    old[m.group(1)] = m.group(2)
            for sign, ln, t in rows:
                m = GOMOD_REQ.match(t) if sign == "+" else None
                if not m or old.get(m.group(1)) == m.group(2):
                    continue
                indirect = bool(m.group(3))
                o = old.get(m.group(1))
                found.append(dict(eco="go", name=m.group(1), old=o, new=m.group(2), file=path, line=ln, gomod_dir=d,
                                  rank=3 if indirect else (0 if o else 1)))
        elif base == "package.json":
            declared = declared_npm(show_head(path))
            old = {}
            for sign, _, t in rows:
                m = JSON_DEP.match(t) if sign == "-" else None
                if m:
                    old[m.group(1)] = spec_version(m.group(2))
            for sign, ln, t in rows:
                m = JSON_DEP.match(t) if sign == "+" else None
                if not m or m.group(1) not in declared:
                    continue
                new = spec_version(m.group(2))
                if new and old.get(m.group(1)) != new:
                    o = old.get(m.group(1))
                    found.append(dict(eco="npm", name=m.group(1), old=o, new=new, file=path, line=ln, rank=0 if o else 1))
        elif base == "Cargo.toml":
            declared = declared_cargo(show_head(path))
            old = {}
            for sign, _, t in rows:
                m = CARGO_DEP.match(t) if sign == "-" else None
                if m:
                    old[m.group(1)] = spec_version(m.group(2) or m.group(3))
            for sign, ln, t in rows:
                m = CARGO_DEP.match(t) if sign == "+" else None
                if not m or m.group(1) not in declared:
                    continue
                new = spec_version(m.group(2) or m.group(3))
                if new and old.get(m.group(1)) != new:
                    o = old.get(m.group(1))
                    found.append(dict(eco="cargo", name=m.group(1), old=o, new=new, file=path, line=ln, rank=0 if o else 1))
        elif base in ("package-lock.json", "yarn.lock", "pnpm-lock.yaml"):
            pj = os.path.join(d, "package.json")
            names = set(declared_npm(show_head(pj)))
            if not names:
                continue
            before, after = lock_versions(path, show_base(path), names), lock_versions(path, show_head(path), names)
            for n, v in sorted(after.items()):
                if before.get(n) and before[n] != v:
                    found.append(dict(eco="npm", name=n, old=before[n], new=v, file=path, line=None, rank=0))
    seen, out = set(), []
    for f in sorted(found, key=lambda f: f["rank"]):  # stable: a package.json row beats its lockfile row
        if (f["eco"], f["name"]) not in seen:
            seen.add((f["eco"], f["name"]))
            out.append(f)
    return out


def github_slug(s):
    m = re.search(r"github\.com[/:]([\w.-]+)/([\w.-]+?)(?:\.git)?(?:[/#?].*)?$", s or "")
    return f"{m.group(1)}/{m.group(2)}" if m else None


def safe_name(name):
    return re.sub(r"[^\w.@+-]", "_", name)


def trim_changelog(text, lo, hi):
    """Sections of a markdown changelog whose heading names a version in (lo, hi]; whole text if none parse."""
    parts = re.split(r"(?m)^(?=#{1,3} )", text)
    keep = []
    for p in parts:
        head = p.splitlines()[0] if p.strip() else ""
        k = vkey(head) if head.startswith("#") else None
        if k and (lo is None or k > lo) and (hi is None or k <= hi):
            keep.append(p)
    return "".join(keep) if keep else text


def registry_latest(dep, cwd):
    """(latest, repository slug or None, version list or None) from the ecosystem's registry."""
    eco, name = dep["eco"], dep["name"]
    if eco == "go":
        env = dict(os.environ, GOFLAGS="-mod=mod", GOTOOLCHAIN="local", GOSUMDB="off")
        out = fetch_cmd(["go", "list", "-m", "-versions", name], cwd=cwd, env=env)
        vs = out.split()[1:]
        stable = [v for v in vs if "-" not in v]
        if not vs:
            raise FetchError("go list: no versions")
        return (stable or vs)[-1], github_slug(name), vs
    if eco == "npm":
        j = json.loads(curl(f"https://registry.npmjs.org/{name.replace('/', '%2F')}/latest"))
        repo = j.get("repository")
        return j["version"], github_slug(repo.get("url") if isinstance(repo, dict) else repo), None
    j = json.loads(curl(f"https://crates.io/api/v1/crates/{name}"))
    c = j.get("crate") or {}
    vs = [v["num"] for v in (j.get("versions") or []) if not v.get("yanked")]
    return c.get("max_stable_version") or c["newest_version"], github_slug(c.get("repository")), vs[::-1]


def github_releases(slug, lo, hi):
    """Markdown of the releases of a GitHub repo whose tag is in (lo, hi], oldest first so the 40 KB cap
    drops the releases past the new pin rather than the ones between old and new; "" if none."""
    url = f"repos/{slug}/releases?per_page=60"
    try:
        raw = fetch_cmd(["gh", "api", url])
    except FetchError:
        raw = curl(f"https://api.github.com/{url}")
    rels = []
    for r in json.loads(raw):
        k = vkey(r.get("tag_name", ""))
        if k and not r.get("draft") and (lo is None or k > lo) and (hi is None or k <= hi):
            rels.append((k, r))
    rels.sort(key=lambda kr: kr[0])
    return "".join(f"# {r['tag_name']} ({str(r.get('published_at') or '')[:10]})\n\n{(r.get('body') or '').strip()}\n\n"
                   for _, r in rels)


def local_changelog(dep, ws):
    """The CHANGELOG* shipped in the module cache or node_modules copy, "" if there is none."""
    root = None
    if dep["eco"] == "go":
        root = module_dir(ws, dep.get("gomod_dir", ""), dep["name"], dep["new"])
    elif dep["eco"] == "npm":
        d = dep["file"] and os.path.dirname(dep["file"])
        while True:
            cand = os.path.join(ws, d, "node_modules", dep["name"])
            if os.path.isdir(cand):
                root = cand
                break
            if not d:
                break
            d = os.path.dirname(d)
    if root:
        for f in sorted(os.listdir(root)):
            if f.upper().startswith(("CHANGELOG", "CHANGES", "HISTORY")) and os.path.isfile(os.path.join(root, f)):
                with open(os.path.join(root, f), errors="replace") as fh:
                    return fh.read()
    return ""


def resolve_upstream(dep, ws, out_dir, scratch_note):
    """Fetch and write the notes for one dependency; (context message, diagnostic or None)."""
    name, new, old = dep["name"], dep["new"], dep.get("old")
    try:
        latest, slug, versions = registry_latest(dep, out_dir)
    except (FetchError, ValueError, KeyError) as e:
        return f"upstream {name}: unavailable ({e})", None
    lo = vkey(old) if old and not is_pseudo(old) else None
    pin = vkey(new)
    stale = bool(pin and vkey(latest) and vkey(latest) > pin)
    hi = vkey(latest) if stale else pin
    if old is None and pin:  # an addition: the notes for the pinned release itself, then anything newer
        lo = (pin[0], pin[1], pin[2], 0, "")
    pdir = os.path.join(out_dir, "upstream", safe_name(name))
    os.makedirs(pdir, exist_ok=True)
    notes, why, fname = "", "", "releases.md"
    if slug:
        try:
            notes = github_releases(slug, lo, hi)
        except (FetchError, ValueError) as e:
            why = str(e)
    if not notes:
        try:
            text = local_changelog(dep, ws)
        except OSError:
            text = ""
        if not text and slug:
            for f in ("CHANGELOG.md", "CHANGES.md"):
                try:
                    text = curl(f"https://raw.githubusercontent.com/{slug}/HEAD/{f}")
                    break
                except FetchError:
                    continue
        if text:
            notes, fname = trim_changelog(text, lo, hi), "CHANGELOG.md"
    wrote = []
    if notes:
        if len(notes.encode()) > MAX_NOTES_BYTES:
            notes = notes.encode()[:MAX_NOTES_BYTES].decode(errors="ignore") + "\n\n[truncated at 40 KB]\n"
        with open(os.path.join(pdir, fname), "w") as fh:
            fh.write(f"<!-- {name}: releases after {old or 'the pinned release'} through {latest if stale else new}"
                     f"{f'; the diff pins {new}, so everything above it is not yet adopted' if stale else ''} -->\n\n{notes}")
        wrote.append(fname)
    if versions:
        with open(os.path.join(pdir, "versions.txt"), "w") as fh:
            fh.write("\n".join(versions) + "\n")
        wrote.append("versions.txt")
    span = f"{old}→{new}" if old else f"added at {new}"
    if not wrote:
        return f"upstream {name} {span} (latest {latest}): unavailable (no release notes found{'; ' + why if why else ''})", None
    target = os.path.join(pdir, wrote[0])
    msg = f"upstream {name} {span} (latest {latest}): {target}{scratch_note}"
    diag = None
    if stale:
        diag = {"tool": "upstream", "file": dep["file"] or None, "line": dep.get("line"),
                "message": f"{name} is pinned at {new}; the latest release is {latest}"}
    return msg, diag


def upstream_stage(ws, base, head, contract, text):
    """(context items, diagnostics). Notes land in <out>/upstream/<pkg>/ — the contract's per-node
    out directory, else the directory holding the saved diff — or a scratch directory when neither is writable."""
    global UPSTREAM_END
    by_file = diff_by_file(text)
    deps = dependency_changes(by_file, lambda p: show_rev(ws, head, p) if head else _read(ws, p),
                              lambda p: show_rev(ws, base, p))
    have = {(d["eco"], d["name"]) for d in deps}
    for eco, name, ver, gomod_dir in IMPORTED:
        if (eco, name) not in have and ver:
            have.add((eco, name))
            deps.append(dict(eco=eco, name=name, old=None, new=ver, file="", line=None, rank=2, gomod_dir=gomod_dir))
    deps = sorted(deps, key=lambda d: d["rank"])[:MAX_UPSTREAM]
    if not deps:
        return [], []
    out_dir, note = None, ""
    cands = []
    if isinstance(contract.get("out"), str) and contract["out"]:
        cands.append(contract["out"])
    if contract.get("diff"):
        cands.append(os.path.dirname(contract["diff"]))
    for cand in cands:
        if os.path.isdir(cand) and os.access(cand, os.W_OK):
            out_dir = cand
            break
    if not out_dir:
        import tempfile
        out_dir = tempfile.mkdtemp(prefix="review-upstream-")
        note = " (scratch dir: the harness gave this node no output directory)"
    from concurrent.futures import ThreadPoolExecutor, wait
    UPSTREAM_END = time.monotonic() + UPSTREAM_BUDGET
    ex = ThreadPoolExecutor(max_workers=len(deps))
    futs = [ex.submit(resolve_upstream, d, ws, out_dir, note) for d in deps]
    wait(futs, timeout=UPSTREAM_BUDGET + 0.5)
    ex.shutdown(wait=False, cancel_futures=True)
    items, diags = [], []
    for d, f in zip(deps, futs):
        try:
            msg, diag = f.result(timeout=0) if f.done() else (f"upstream {d['name']}: unavailable (stage budget spent)", None)
        except Exception as e:
            msg, diag = f"upstream {d['name']}: unavailable ({str(e)[:80]})", None
        items.append((-2, None, None, f"upstream:{d['name']}", msg))
        if diag:
            diags.append(diag)
    return items, diags


def _read(ws, path):
    try:
        with open(os.path.join(ws, path), errors="replace") as fh:
            return fh.read()
    except Exception:
        return ""


